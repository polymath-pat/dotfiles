export EDITOR="nvim"
export VISUAL="nvim"
zstyle :zle:edit-command-line editor nvim '+:set ft=zsh'
autoload -Uz edit-command-line
autoload -U compinit; compinit
zle -N edit-command-line
bindkey -M vicmd 'v' edit-command-line
# updates backspace to actually backspace
bindkey -M viins "^?" backward-delete-char

# Maximum lines kept in memory
export HISTSIZE=100000
# Maximum lines saved to $HISTFILE
export SAVEHIST=100000

# Updated PATH
export PATH=$PATH:~/bin

# crusoe cloud-admin
source ~/.config/zsh/_cloud-admin.zsh
alias ca='cloud-admin'

# kubectl shell completion
source ~/.config/zsh/_k8s.zsh
alias k='kubectl'

# Enable Vi mode
bindkey -v
export KEYTIMEOUT=1

# Define vi mode indicators
VIMODE_INS="[+]"
VIMODE_CMD="[-]"
VIMODE=$VIMODE_INS

# Function to update vi mode on keymap change
function zle-keymap-select {
  VIMODE="${${KEYMAP/vicmd/$VIMODE_CMD}/(main|viins)/$VIMODE_INS}"
  [[ $KEYMAP == vicmd ]] && echo -ne '\e[2 q' || echo -ne '\e[6 q'
  zle reset-prompt
}
zle -N zle-keymap-select

# Reset to insert vi mode for new lines
function zle-line-init {
  VIMODE=$VIMODE_INS
  zle reset-prompt
}
zle -N zle-line-init

# keychain ssh-agent support
function unchain() {
    if [ -f "${HOME}/.keychain/MBP-Patrick-Cantu-sh" ]; then
        source "${HOME}/.keychain/MBP-Patrick-Cantu-sh"
    else
        keychain ~/.ssh/crusoe_cloud_gitlab
        keychain ~/.ssh/crusoe_cloud_pcantu
        keychain ~/.ssh/crusoe_polymath_pat
        source "${HOME}/.keychain/MBP-Patrick-Cantu-sh"
    fi
}

# Add $VIMODE to your prompt (example).
#setopt PROMPT_SUBST
#PROMPT='${VIMODE} %n@%m %~ '

# allow using "#" for command comments in shell.
setopt interactive_comments

# Enable Git branch info in Zsh prompt
autoload -Uz vcs_info
precmd() { vcs_info }
zstyle ':vcs_info:git:*' formats '(%b)'
setopt PROMPT_SUBST
PROMPT='${VIMODE} %F{cyan}%~%f %F{green}${vcs_info_msg_0_}%f %F{yellow}➔%f '
